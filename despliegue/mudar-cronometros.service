# Cierra los cronómetros de producción que nadie cerró.
#
# No se habilita por su cuenta: quien lo dispara es mudar-cronometros.timer, que
# activa por omisión el servicio de su mismo nombre. Por eso aquí no hay [Install].
#
# Se instala copiándolo a /etc/systemd/system/ y recargando con
# systemctl daemon-reload. Comprobar antes que las rutas de abajo existan.

[Unit]
Description=Cierra los cronómetros de producción olvidados
# Solo ordena; no arranca esas unidades. Si PostgreSQL está parado, el barrido
# debe fallar y quedar registrado, no levantar la base de datos por su cuenta.
After=network.target postgresql.service

[Service]
# Arranca, hace su trabajo y termina. Sin esto, systemd esperaría un proceso que
# se queda vivo y tomaría el final como una caída.
Type=oneshot
User=mudar
Group=mudar

# systemd no ejecuta un shell: no hay PATH, ni cd, ni variables heredadas. Por
# eso el directorio del proyecto se declara aquí y la ruta al intérprete es
# absoluta.
WorkingDirectory=/opt/mudar

# Las credenciales y la SECRET_KEY. Lo lee systemd como root y después baja a
# mudar, que NO puede abrir ese archivo (600, root).
#
# ⚠️ Sin esta línea el comando muere al importar Django, antes de hacer nada:
#    settings.py hace 20 llamadas a config() y SECRET_KEY y las credenciales de
#    la base no tienen valor por omisión. En el servidor NO hay ningún .env en
#    /opt/mudar, así que python-decouple no tiene de dónde leerlas.
EnvironmentFile=/etc/mudar/env

# Sin esto, Python acumula su salida en un búfer y la suelta al terminar. En un
# comando que falla a mitad, el diario se queda vacío y parece que nunca corrió.
Environment=PYTHONUNBUFFERED=1

# Garantiza /var/log/mudar con el dueño y el modo correctos aunque esta unidad
# se dispare antes de que mudar-web haya arrancado alguna vez. Mismos valores
# que allí, para que las dos no se pisen el modo.
LogsDirectory=mudar
LogsDirectoryMode=0750

ExecStart=/opt/mudar/venv/bin/python manage.py cerrar_cronometros
