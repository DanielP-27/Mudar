# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Frontend (Vite / React)
#
# ATENCION: Vite incrusta estos valores dentro del JavaScript
# compilado. Son PUBLICOS: cualquier usuario puede leerlos desde
# las herramientas de desarrollo del navegador.
# NUNCA colocar secretos en este archivo.
# ─────────────────────────────────────────────────────────────

# URL del backend, para DESARROLLO (npm run dev).
# El puerto 8000 es Gunicorn/runserver directo: en desarrollo el frontend vive
# en 5173, asi que son origenes distintos y CORS interviene.
#
# ATENCION: al COMPILAR (npm run build) este valor NO se usa. Vite lee ademas
# client/.env.production y pisa a esta. Ese archivo esta fuera de git (.gitignore
# cubre .env.*), asi que hay que crearlo en cada maquina donde se compile, y va
# con la variable VACIA: en produccion Nginx sirve el frontend y la API desde el
# MISMO origen, de modo que el bundle usa rutas relativas, no lleva dominio
# incrustado y alli no hay puerto ni CORS.
VITE_API_URL=http://localhost:8000
