# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — Backend (Django)
#
# Copiar este archivo como .env y completar los valores.
# El .env real NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Base de datos PostgreSQL ──
DB_NAME=mudar_db
# En produccion debe ser un rol dedicado, NO el superusuario 'postgres'
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Django ──
# Generar una llave distinta por cada entorno (nunca reutilizar):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Envolver el valor en comillas simples: el alfabeto incluye '#',
# que sin comillas trunca el valor silenciosamente.
SECRET_KEY=

# Solo True en desarrollo local. En produccion SIEMPRE False.
DEBUG=False

# ── Hosts y CORS ──
# Dominios desde los que se sirve el backend, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origen del frontend autorizado a consumir la API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origenes confiables para el CSRF del panel de administracion.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Ruta del panel de administracion. Debe terminar en barra.
ADMIN_URL=admin/

# Carpeta donde se escriben los registros de la aplicacion.
# Si se omite, se usa la carpeta 'logs' dentro del proyecto.
# En produccion: /var/log/mudar (debe existir y pertenecer al usuario del servicio).
LOG_DIR=

# ── Correo saliente (solo avisos tecnicos al equipo) ──
# Direccion que recibe los avisos de error del sistema. Si se deja vacia, el
# aviso no se envia a nadie: el error se sigue escribiendo en mudar.log.
CORREO_AVISOS=

# Por omision se imprime en consola en vez de enviarse. En produccion:
# django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Remitente de los avisos. Debe ser una direccion que el servidor SMTP autorice
# a enviar; con Microsoft 365, normalmente la misma de EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
